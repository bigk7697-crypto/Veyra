{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd api && npm install --no-audit --no-fund && npm run build",
  "outputDirectory": "api/public",
  "functions": {
    "api/server.js": { "memory": 1024, "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/v1/:path*", "destination": "/api/server" },
    { "source": "/health", "destination": "/api/server" }
  ]
}
