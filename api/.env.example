# Copiez vers .env puis ajustez. Toutes les valeurs ont un défaut dev.
PORT=3000
PUBLIC_BASE_URL=https://veyra.example.com

# CORS : domaines de vos frontends, séparés par des virgules. Vide = ouvert (dev uniquement).
CORS_ORIGINS=https://app.example.com,https://admin.example.com

# Domaines autorisés à appeler le widget depuis un navigateur. Vide = ouvert.
# Recommandé en prod : créez les challenges CÔTÉ SERVEUR (pas d'Origin requis).
WIDGET_ALLOWED_ORIGINS=https://app.example.com

# Rate limiting global (par IP).
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute

# Challenge : durée de vie (s) et essais max.
CHALLENGE_TTL_SECONDS=120
CHALLENGE_MAX_ATTEMPTS=3

# Page de démo sur / : true en dev, false en prod.
DEMO_ENABLED=true

# Clé maîtresse AES-256-GCM (64 hex). Si absente, générée dans data/master.key.
# En prod multi-instance/Docker : fixez-la et montez ./data en volume.
VEYRA_MASTER_KEY=

LOG_LEVEL=info
# Mettre 1 derrière un reverse proxy (nginx, Caddy, load balancer).
TRUST_PROXY=0
